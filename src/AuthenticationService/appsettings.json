{
  // -----------------------------------------------------------------------
  // appsettings.json — base configuration (committed to source control)
  //
  // SECURITY RULES:
  //   • Do NOT place real secrets (ClientSecret, keys, passwords) here.
  //   • Secrets must be supplied at runtime via:
  //       - Environment variables  (SsoSettings__ClientSecret)
  //       - Azure Key Vault / AWS Secrets Manager / HashiCorp Vault
  //       - .NET User Secrets (development only, never committed)
  //   • This file contains only structural defaults and non-sensitive values.
  // -----------------------------------------------------------------------

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  // Token settings for internal opaque-token issuance
  "TokenSettings": {
    "TokenExpirationMinutes": 60,
    "CleanupIntervalMinutes": 15
  },

  // JWT settings (used when JWT format is enabled)
  "JwtSettings": {
    // SecretKey MUST be overridden via environment variable: JwtSettings__SecretKey
    "SecretKey": "",
    "Issuer": "AuthenticationService",
    "Audience": "AuthenticationServiceClients",
    "ExpirationMinutes": 60
  },

  // -----------------------------------------------------------------------
  // SSO / Identity Provider settings
  //
  // ClientId     — non-secret; safe to store here as a placeholder.
  //                Override per-environment via SsoSettings__ClientId.
  // ClientSecret — MUST remain empty here; supply via environment variable
  //                SsoSettings__ClientSecret or a secrets manager.
  // -----------------------------------------------------------------------
  "SsoSettings": {
    // OAuth 2.0 / OIDC client identifier registered with the identity provider.
    // Override via environment variable: SsoSettings__ClientId
    "ClientId": "",

    // Client secret — leave blank here; inject at runtime only.
    // Environment variable: SsoSettings__ClientSecret
    "ClientSecret": "",

    // Identity provider authorization endpoint.
    // Example (Azure AD): https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/authorize
    // Override via environment variable: SsoSettings__AuthorizationEndpoint
    "AuthorizationEndpoint": "",

    // Identity provider token endpoint.
    // Example (Azure AD): https://login.microsoftonline.com/{tenant-id}/oauth2/v2.0/token
    // Override via environment variable: SsoSettings__TokenEndpoint
    "TokenEndpoint": "",

    // Optional OIDC discovery document URL for automatic endpoint resolution.
    // Example: https://login.microsoftonline.com/{tenant-id}/v2.0/.well-known/openid-configuration
    "MetadataAddress": "",

    // Whitelist of pre-registered redirect URIs.
    // Only URIs in this list are accepted; all others are rejected (Open Redirect mitigation).
    // Override via environment variable array: SsoSettings__AllowedRedirectUris__0, __1, ...
    "AllowedRedirectUris": [
      "https://hris.example.com/auth/callback",
      "https://hris.example.com/signin-oidc"
    ],

    // OAuth 2.0 scopes requested from the identity provider.
    "Scopes": [
      "openid",
      "profile",
      "email"
    ]
  }
}
