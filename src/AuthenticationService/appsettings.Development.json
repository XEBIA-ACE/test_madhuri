{
  // -----------------------------------------------------------------------
  // appsettings.Development.json — development environment overrides
  //
  // This file is loaded ONLY when ASPNETCORE_ENVIRONMENT=Development.
  // It is safe to commit placeholder / local-dev values here, but
  // NEVER commit real production secrets.
  //
  // For actual secret values in development use .NET User Secrets:
  //   dotnet user-secrets set "SsoSettings:ClientSecret" "<your-dev-secret>"
  //   dotnet user-secrets set "SsoSettings:ClientId"     "<your-dev-client-id>"
  // -----------------------------------------------------------------------

  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "AuthenticationService": "Debug"
    }
  },

  "TokenSettings": {
    "TokenExpirationMinutes": 120,
    "CleanupIntervalMinutes": 5
  },

  "JwtSettings": {
    // Development-only placeholder key — override via User Secrets in real dev setups.
    // dotnet user-secrets set "JwtSettings:SecretKey" "<random-256-bit-key>"
    "SecretKey": "",
    "Issuer": "AuthenticationService-Dev",
    "Audience": "AuthenticationServiceClients-Dev",
    "ExpirationMinutes": 120
  },

  "SsoSettings": {
    // Development identity provider client ID.
    // Recommended: set via User Secrets → dotnet user-secrets set "SsoSettings:ClientId" "..."
    "ClientId": "",

    // Development client secret — MUST be set via User Secrets, never hard-coded.
    // dotnet user-secrets set "SsoSettings:ClientSecret" "<dev-secret>"
    "ClientSecret": "",

    // Use a local or staging identity provider for development.
    // Example using a local Keycloak instance:
    //   "AuthorizationEndpoint": "http://localhost:8080/realms/dev/protocol/openid-connect/auth"
    "AuthorizationEndpoint": "",

    // Example using a local Keycloak instance:
    //   "TokenEndpoint": "http://localhost:8080/realms/dev/protocol/openid-connect/token"
    "TokenEndpoint": "",

    // OIDC discovery document for the dev identity provider (optional).
    "MetadataAddress": "",

    // Localhost redirect URIs for development testing.
    "AllowedRedirectUris": [
      "https://localhost:5001/auth/callback",
      "https://localhost:5001/signin-oidc",
      "http://localhost:5000/auth/callback",
      "http://localhost:5000/signin-oidc"
    ],

    "Scopes": [
      "openid",
      "profile",
      "email"
    ]
  }
}
