# =============================================================================
# .env.example — Environment variable template for AuthenticationService
#
# Copy this file to .env (or set these variables in your deployment platform)
# and fill in the real values.
#
# IMPORTANT:
#   • .env is listed in .gitignore and must NEVER be committed to source control.
#   • This .env.example file documents required variables and IS safe to commit.
#   • In production, inject secrets via your platform's secret management:
#       - Kubernetes Secrets / Sealed Secrets
#       - AWS Secrets Manager / Parameter Store
#       - Azure Key Vault
#       - HashiCorp Vault
# =============================================================================

# ---------------------------------------------------------------------------
# ASP.NET Core runtime environment
# ---------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=https://+:443;http://+:80

# ---------------------------------------------------------------------------
# SSO / Identity Provider settings
#
# These map to the SsoSettings section in appsettings.json.
# The double-underscore (__) is the ASP.NET Core convention for nested keys.
# ---------------------------------------------------------------------------

# OAuth 2.0 / OIDC Client ID registered with the identity provider.
SsoSettings__ClientId=<your-idp-client-id>

# OAuth 2.0 / OIDC Client Secret — treat as a password; never log or expose.
SsoSettings__ClientSecret=<your-idp-client-secret>

# Identity provider authorization endpoint URL.
# Azure AD example:
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize
# Okta example:
#   https://<your-okta-domain>/oauth2/default/v1/authorize
SsoSettings__AuthorizationEndpoint=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/authorize

# Identity provider token endpoint URL.
# Azure AD example:
#   https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token
SsoSettings__TokenEndpoint=https://login.microsoftonline.com/<tenant-id>/oauth2/v2.0/token

# Optional: OIDC discovery document URL (enables automatic endpoint resolution).
# Azure AD example:
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
SsoSettings__MetadataAddress=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration

# Whitelist of approved redirect URIs (index-based array notation).
# Only URIs in this list are accepted; all others are rejected.
SsoSettings__AllowedRedirectUris__0=https://hris.example.com/auth/callback
SsoSettings__AllowedRedirectUris__1=https://hris.example.com/signin-oidc

# ---------------------------------------------------------------------------
# JWT settings (internal token signing)
# ---------------------------------------------------------------------------

# Secret key for signing JWT tokens — must be at least 32 characters (256 bits).
# Generate with: openssl rand -base64 32
JwtSettings__SecretKey=<generate-a-strong-random-key>

JwtSettings__Issuer=AuthenticationService
JwtSettings__Audience=AuthenticationServiceClients
JwtSettings__ExpirationMinutes=60

# ---------------------------------------------------------------------------
# Token settings (opaque token store)
# ---------------------------------------------------------------------------
TokenSettings__TokenExpirationMinutes=60
TokenSettings__CleanupIntervalMinutes=15
